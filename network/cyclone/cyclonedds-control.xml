<CycloneDDS>
  <Domain Id="any">

    <General>
      <Interfaces>
        <!-- WireGuard interface (experimental, commented out) -->
        <!-- <NetworkInterface name="wg0" address="10.0.0.1" priority="100" multicast="false"/> -->

        <!-- Robot/server LAN interface -->
        <NetworkInterface name="enp5s0" address="10.24.10.102" priority="100" multicast="false"/>
      </Interfaces>

      <!-- Allow multicast only where the interface allows it.
           wg0 has multicast=false above, LAN has multicast=true. -->
      <AllowMulticast>false</AllowMulticast>
    </General>

    <Discovery>
      <Peers>
        <!-- WireGuard client (experimental, commented out) -->
        <!-- <Peer Address="10.0.0.10"/> -->

        <!-- Robot LAN machines -->
        <Peer Address="10.24.10.100"/>
        <Peer Address="10.24.10.101"/>
        <Peer Address="10.24.10.102"/>
      </Peers>
    </Discovery>

  </Domain>
</CycloneDDS>